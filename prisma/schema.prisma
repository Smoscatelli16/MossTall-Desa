// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum Role {
  USER
  ADMIN
}

// Máquina de Estados Estricta (Spec #016 / #017)
enum TransactionState {
  PENDING
  PAID_HELD
  DELIVERY_CONFIRMED
  FUNDS_RELEASED
  DISPUTED
  REFUNDED
}

enum ListingType {
  PRODUCTO      
  SERVICIO      
  INFOPRODUCTO  
}

// Estado del ítem
enum ProductCondition {
  NUEVO
  USADO
  REACONDICIONADO
}

// BRIEF #030: Selector de Riel de Pago
enum PaymentGateway {
  MERCADO_PAGO
  BIND
}

// BRIEF #038: Mercado Inverso (Tablón)
enum NeedListingStatus {
  OPEN
  FULFILLED
  CANCELLED
}

// BRIEF #040: Tipos de Tienda / Perfil Dinámico
enum StoreType {
  PRODUCT_STORE
  SERVICE_PROFESSIONAL
  DIGITAL_CREATOR
}

// BRIEF #054: Estados Logísticos
enum ShipmentStatus {
  PENDING
  PREPARING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  FAILED
}

// --- MODELOS DE DATOS ---

// 1. Modelo de CATEGORÍAS
model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique 
  parentId  String?    
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  products  Product[]
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// 2. Modelo de USUARIO (Cuenta Paraguas)
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String?   // Opcional para soportar Google OAuth
  name                String?
  role                Role      @default(USER)
  
  // -- EMPALME KYC Y BLINDAJE LEGAL --
  dni                 String?   @unique // KYC Progresivo: Se llena más adelante al crear Tienda
  phone               String?   @unique // TASK 49.2: Unicidad validada
  birthDate           DateTime? // TASK 52.3: Validación de mayoría de edad (+18)
  
  // TASK 53.2: Registro de Auditoría de Aceptación Legal
  termsAccepted       Boolean   @default(false)
  termsAcceptedAt     DateTime? 
  acceptedTermsAt     DateTime  @default(now()) // Timestamp inmutable de aceptación inicial
  termsVersion        String    @default("1.0") // Control de versionado contractual

  // -- BRIEF #052: MURO DE SEGURIDAD BASE Y TELEMETRÍA --
  isEmailVerified     Boolean   @default(false)
  activationToken     String?   @unique
  registrationIp      String?
  
  // -- SISTEMA DE REPUTACIÓN GLOBAL COMO COMPRADOR / USUARIO --
  ratingAverage       Float     @default(0.0)
  totalReviews        Int       @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // -- RELACIÓN MULTI-TIENDA (BRIEF #040) --
  stores              Store[]   @relation("UserStores")

  services            Service[] // (Legacy)
  
  // Relación Mercado Inverso (Brief #038)
  needs               NeedListing[] @relation("UserNeeds")

  transactionsAsBuyer Transaction[] @relation("BuyerTransactions")
  transactionsAsSeller Transaction[] @relation("SellerTransactions")
  
  // -- SISTEMA DE CALIFICACIONES LEGACY (Rating) --
  ratingsGiven        Rating[]      @relation("RaterRatings")
  ratingsReceived     Rating[]      @relation("RatedRatings")
  
  // -- SISTEMA DE REPUTACIÓN V2 (Review & Reports) --
  reviewsWritten      Review[]      @relation("WrittenReviews")
  reviewsReceived     Review[]      @relation("ReceivedReviews")
  reportsMade         UserReport[]  @relation("ReporterReports")
  reportsReceived     UserReport[]  @relation("ReportedReports")

  professionalProfile ProfessionalProfile?

  // RELACIONES DE PREGUNTAS
  questionsAsker      Question[]    @relation("AskerQuestions")

  // RELACIONES DE CHAT (SPEC #009)
  sentMessages        Message[]     @relation("SentMessages")

  // TASK 54.1: Direcciones guardadas del usuario para checkout
  addresses           Address[]     @relation("UserAddresses")

  // BRIEF #039: Índices para búsquedas rápidas por email
  @@index([email])
}

// 2.1 NUEVO: Modelo de TIENDA / PERFIL (BRIEF #040)
model Store {
  id                  String      @id @default(uuid())
  
  owner               User        @relation("UserStores", fields: [ownerId], references: [id])
  ownerId             String

  name                String
  description         String?     @db.Text
  logoUrl             String?

  type                StoreType

  // TASK 53.4: Disparador de KYC Progresivo (Merchant Wall)
  isMerchantVerified  Boolean     @default(false)

  // -- DATOS BANCARIOS DESACOPLADOS DEL USUARIO --
  cbu                 String?     
  cvu                 String?     
  alias               String?

  // -- MÉTRICAS INDEPENDIENTES DE LA TIENDA --
  ratingAverage       Float       @default(0.0)
  totalReviews        Int         @default(0)
  totalSales          Int         @default(0)

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Los productos ahora pertenecen a la tienda, no al usuario
  products            Product[]   @relation("StoreProducts")

  // TASK 54.1: Domicilio comercial de origen para el cálculo de envíos
  address             Address?    @relation("StoreAddress")

  @@index([ownerId])
}

// 3. Modelo de PERFIL PROFESIONAL (SPEC #010) - (Candidato a deprecarse o unirse a Store)
model ProfessionalProfile {
  id              String    @id @default(uuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String    @unique

  profession      String?   // Ej: "Electricista Matriculado" (Antes 'title')
  biography       String?   @db.Text // "Sobre mí / Experiencia" (Antes 'summary')
  
  portfolioImages String[]  // Array de URLs de fotos de trabajos
  certifications  String[]  // Lista de títulos o cursos realizados

  experienceYears Int?
  education       String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 4. Modelo de PRODUCTO (Publicación ligada a la Tienda)
model Product {
  id              String      @id @default(uuid())
  
  // -- NUEVA RELACIÓN (BRIEF #040) --
  store           Store       @relation("StoreProducts", fields: [storeId], references: [id])
  storeId         String
  
  category        Category?   @relation(fields: [categoryId], references: [id])
  categoryId      String?     
  
  suggestedCategory String?

  type            ListingType @default(PRODUCTO)

  title           String
  description     String      @db.Text
  price           Float
  images          String[]
  status          String      @default("DISPONIBLE") // DISPONIBLE, PAUSADO, SIN_STOCK

  // --- CONTROL DE STOCK ---
  stock           Int         @default(1) 

  // Detalles opcionales
  condition       ProductCondition? 
  brand           String?           
  model           String?           
  year            Int?                
  mileage         Int?                

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  transactions    Transaction[]
  
  // RELACIONES DE PREGUNTAS
  questions       Question[] 

  @@index([storeId])
  @@index([status])
}

// 5. Modelo de SERVICIO (LEGACY)
model Service {
  id              String    @id @default(uuid())
  creator         User      @relation(fields: [creatorId], references: [id])
  creatorId       String
  title           String
  description     String    @db.Text
  price           Float
  status          String    @default("DISPONIBLE")
  timesContracted Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions    Transaction[]
}

// -- NUEVO: Modelo de MERCADO INVERSO (Tablón de Necesidades - Brief #038) --
model NeedListing {
  id              String            @id @default(uuid())
  user            User              @relation("UserNeeds", fields: [userId], references: [id])
  userId          String

  title           String
  description     String            @db.Text
  estimatedBudget Float?
  status          NeedListingStatus @default(OPEN)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Múltiples oferentes pueden abrir un chat para una sola necesidad
  chatRooms       ChatRoom[]

  // BRIEF #039: Índices para evitar escaneos completos
  @@index([userId])
  @@index([status])
}

// 6. Modelo de TRANSACCIÓN
model Transaction {
  id                 String            @id @default(uuid())
  buyer              User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  buyerId            String
  seller             User              @relation("SellerTransactions", fields: [sellerId], references: [id])
  sellerId           String
  
  product            Product?          @relation(fields: [productId], references: [id])
  productId          String?
  service            Service?          @relation(fields: [serviceId], references: [id])
  serviceId          String?

  // ESTADO Y FINANZAS
  state              TransactionState  @default(PENDING)
  
  // BRIEF #030: Memoria Transaccional
  paymentGateway       PaymentGateway    @default(MERCADO_PAGO)
  
  amount               Decimal
  platformFee          Decimal
  sellerPayout         Decimal
  
  // Trazabilidad Contable (Calculadora Inversa BIND)
  targetNetAmount      Decimal @default(0)
  grossAmount          Decimal @default(0)
  gatewayFeeAmount     Decimal @default(0)
  taxFeeAmount         Decimal @default(0)
  netPlatformFeeAmount Decimal @default(0)
  sellerFinalAmount    Decimal @default(0)

  mercadoPagoId   String?           @unique
  
  // BRIEF #041: Identificador de Mercado Inverso
  isReverseMarket Boolean @default(false)
  
  // CAMPOS DE BORRADO LÓGICO
  deletedByBuyer  Boolean @default(false)
  deletedBySeller Boolean @default(false)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  rating          Rating? // (Legacy)
  review          Review? // (Sistema V2)
  
  // CHAT ASOCIADO (SPEC #009)
  chatRoom        ChatRoom?

  // Historial de Auditoría (Spec #016 / #017)
  history         TransactionHistory[]

  // TASK 54.1: Integración con logística
  shipment        Shipment?

  // BRIEF #039: Índices para consultas financieras de alta velocidad
  @@index([buyerId])
  @@index([sellerId])
  @@index([state])
}

// 6.1 Modelo de HISTORIAL DE TRANSACCIONES (Audit Trail)
model TransactionHistory {
  id              String            @id @default(uuid())
  
  transaction     Transaction       @relation(fields: [transactionId], references: [id])
  transactionId   String
  
  oldState        TransactionState? // Nullable porque el primer evento no tiene estado previo
  newState        TransactionState
  
  actorId         String?           // Quien detonó el cambio (ID usuario, "WEBHOOK_MP", "SYSTEM_CRON")
  ipAddress       String?           // Registro de IP si aplica

  createdAt       DateTime          @default(now())
}

// 7. Modelo de CALIFICACIÓN (LEGACY)
model Rating {
  id              String      @id @default(uuid())
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  transactionId   String      @unique
  
  rater           User        @relation("RaterRatings", fields: [raterId], references: [id])
  raterId         String
  rated           User        @relation("RatedRatings", fields: [ratedId], references: [id])
  ratedId         String
  
  rating          Int
  comment         String?     @db.Text
  
  quality         Int?
  professionalism Int?
  communication   Int?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// 8. Modelo de PREGUNTAS (Q&A)
model Question {
  id           String    @id @default(uuid())
  content      String    @db.Text 
  
  answer       String?   @db.Text 
  answeredAt   DateTime?         
  
  isReadByAsker Boolean @default(false) 

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt 

  product      Product  @relation(fields: [productId], references: [id])
  productId    String
  
  asker        User     @relation("AskerQuestions", fields: [askerId], references: [id])
  askerId      String
}

// 9. Modelo de RESEÑAS (Review V2)
model Review {
  id              String      @id @default(uuid())
  
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  transactionId   String      @unique 

  reviewer        User        @relation("WrittenReviews", fields: [reviewerId], references: [id])
  reviewerId      String
  reviewed        User        @relation("ReceivedReviews", fields: [reviewedId], references: [id])
  reviewedId      String

  rating          Int         
  comment         String?     @db.Text
  createdAt       DateTime    @default(now())
}

// 10. Modelo de REPORTES (Seguridad V2)
model UserReport {
  id           String    @id @default(uuid())
  
  reporter     User      @relation("ReporterReports", fields: [reporterId], references: [id])
  reporterId   String
  
  reported     User      @relation("ReportedReports", fields: [reportedId], references: [id])
  reportedId   String

  reason       String    
  details      String?   @db.Text
  status       String    @default("PENDIENTE") 
  
  createdAt    DateTime @default(now())
}

// 11. SISTEMA DE CHAT (SPEC #009)
model ChatRoom {
  id              String      @id @default(uuid())
  
  // Relación opcional con Transacción (Un chat por compra directa)
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  transactionId   String?      @unique

  // Relación opcional con Mercado Inverso (Varios oferentes pueden abrir chats por una necesidad)
  needListing     NeedListing? @relation(fields: [needListingId], references: [id])
  needListingId   String?

  messages        Message[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt 
}

model Message {
  id            String    @id @default(uuid())
  
  chatRoom      ChatRoom  @relation(fields: [chatRoomId], references: [id])
  chatRoomId    String

  sender        User      @relation("SentMessages", fields: [senderId], references: [id])
  senderId      String

  content       String    @db.Text
  isRead        Boolean   @default(false) 
  
  createdAt     DateTime  @default(now())
}

// 12. SISTEMA DE AUTENTICACIÓN OTP (BRIEF #050)
model OtpVerification {
  id        String   @id @default(uuid())
  phone     String   
  code      String   
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0) // Control de fuerza bruta

  createdAt DateTime @default(now())

  @@index([phone])
}

// 13. Modelo de BANNERS PUBLICITARIOS (BRIEF #051)
model Banner {
  id              String   @id @default(uuid())
  title           String?
  desktopImageUrl String
  mobileImageUrl  String
  targetUrl       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


// --- TASK 54.1: MODELOS LOGÍSTICOS Y GEOGRÁFICOS ---

// 14. Modelo de DIRECCIONES GEOLOCALIZADAS
model Address {
  id             String    @id @default(uuid())
  street         String
  number         String?   // Formato alfanumérico por casos "S/N"
  zipCode        String?
  city           String    @default("Posadas")
  province       String    @default("Misiones")
  reference      String?   @db.Text
  
  latitude       Float?    
  longitude      Float?    

  // Relaciones
  user           User?     @relation("UserAddresses", fields: [userId], references: [id])
  userId         String?

  store          Store?    @relation("StoreAddress", fields: [storeId], references: [id])
  storeId        String?   @unique

  // Historial Logístico (Checkout)
  shipmentsOriginated  Shipment[] @relation("OriginAddress")
  shipmentsDestined    Shipment[] @relation("DestinationAddress")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// 15. Modelo de ENVÍOS / TRACKING (Neo Mandados Integration)
model Shipment {
  id                   String         @id @default(uuid())
  
  transaction          Transaction    @relation(fields: [transactionId], references: [id])
  transactionId        String         @unique

  status               ShipmentStatus @default(PENDING)
  trackingNumber       String?        @unique

  // Direcciones Inmutables para el envío
  originAddress        Address        @relation("OriginAddress", fields: [originAddressId], references: [id])
  originAddressId      String

  destinationAddress   Address        @relation("DestinationAddress", fields: [destinationAddressId], references: [id])
  destinationAddressId String

  // Datos Tarifarios y Telemétricos
  distanceKm           Float?
  shippingCost         Decimal        @default(0)
  estimatedDelivery    DateTime?
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([trackingNumber])
  @@index([status])
}
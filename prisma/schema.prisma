// Este es el archivo "schema" de Prisma.
// Define la conexión a tu base de datos y la estructura de tus tablas.

// 1. Configuración del "Generador"
// Esto le dice a Prisma que genere el "Prisma Client" para TypeScript.
generator client {
  provider = "prisma-client-js"
}

// 2. Configuración de la "Fuente de Datos"
// Aquí le decimos a Prisma que estamos usando PostgreSQL
// y que la URL de conexión está en el archivo .env
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Carga la variable DATABASE_URL del archivo .env
}

// 3. Definición de "Enums" (Tipos predefinidos)

// Roles de Usuario
enum Role {
  USER     // Usuario normal (puede comprar y vender)
  ADMIN    // Administrador de la plataforma
}

// Estados de una Transacción (nuestro flujo de Escrow)
enum TransactionStatus {
  INICIADO           // La transacción fue creada
  PAGADO_EN_RETENCION // El comprador pagó, el dinero está retenido
  COMPLETADO         // El comprador confirmó, el dinero se libera al vendedor
  DISPUTADO          // El comprador inició una disputa
  CANCELADO          // La transacción fue cancelada
}

// 4. Definición de "Modelos" (Nuestras tablas de la base de datos)

// Modelo de Usuario
model User {
  id                  String   @id @default(uuid()) // ID único (ej: "a1b2c3d4-...")
  email               String   @unique // El email debe ser único
  password            String   // La contraseña (guardaremos una versión encriptada)
  name                String?  // Nombre (opcional)
  role                Role     @default(USER) // Por defecto, todos son "USER"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // --- Relaciones ---
  products            Product[]             // Un usuario puede tener muchos Productos
  services            Service[]             // Un usuario puede tener muchos Servicios
  transactionsAsBuyer   Transaction[]         @relation("BuyerTransactions") // Transacciones donde es Comprador
  transactionsAsSeller  Transaction[]         @relation("SellerTransactions") // Transacciones donde es Vendedor
  ratingsGiven        Rating[]              @relation("RaterRatings") // Calificaciones que ha dado
  ratingsReceived     Rating[]              @relation("RatedRatings") // Calificaciones que ha recibido
  professionalProfile ProfessionalProfile?  // Un usuario puede tener UN perfil profesional (o ninguno)
}

// Modelo de Perfil Profesional (asociado a un Usuario)
model ProfessionalProfile {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique // Un perfil por usuario
  title           String?  // Título (ej: "Electricista Matriculado")
  experienceYears Int?     // Años de experiencia
  education       String?  // Educación (ej: "Técnico en...)
  summary         String?  @db.Text // Resumen largo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Modelo de Producto
model Product {
  id          String   @id @default(uuid())
  creator     User     @relation(fields: [creatorId], references: [id])
  creatorId   String
  title       String
  description String   @db.Text
  price       Float    // Usamos Float para precios (ej: 1500.50)
  images      String[] // Un array de URLs de imágenes
  status      String   @default("DISPONIBLE") // ej: DISPONIBLE, VENDIDO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Relaciones ---
  transactions Transaction[] // Un producto puede estar en muchas transacciones
}

// Modelo de Servicio
model Service {
  id              String   @id @default(uuid())
  creator         User     @relation(fields: [creatorId], references: [id])
  creatorId       String
  title           String
  description     String   @db.Text
  price           Float    // Precio base del servicio
  status          String   @default("DISPONIBLE")
  timesContracted Int      @default(0) // Contador de "veces contratado"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // --- Relaciones ---
  transactions Transaction[] // Un servicio puede estar en muchas transacciones
}

// Modelo de Transacción (¡El corazón del Escrow!)
model Transaction {
  id            String            @id @default(uuid())
  buyer         User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  buyerId       String
  seller        User              @relation("SellerTransactions", fields: [sellerId], references: [id])
  sellerId      String
  
  // Una transacción puede ser de UN producto O UN servicio (ambos opcionales ?)
  product       Product?          @relation(fields: [productId], references: [id])
  productId     String?
  service       Service?          @relation(fields: [serviceId], references: [id])
  serviceId     String?

  status        TransactionStatus @default(INICIADO) // El estado del Escrow
  amount        Float             // Monto total pagado por el comprador
  platformFee   Float             // Comisión de MossTall
  sellerPayout  Float             // Dinero a liberar al vendedor
  mercadoPagoId String?           @unique // ID del pago en Mercado Pago
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // --- Relaciones ---
  rating        Rating?           // Una transacción tiene UNA calificación (o ninguna)
}

// Modelo de Calificación (asociado a una Transacción)
model Rating {
  id              String   @id @default(uuid())
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  transactionId   String   @unique // Solo una calificación por transacción
  
  rater           User     @relation("RaterRatings", fields: [raterId], references: [id]) // Quién califica (Comprador)
  raterId         String
  rated           User     @relation("RatedRatings", fields: [ratedId], references: [id]) // A quién califican (Vendedor)
  ratedId         String
  
  rating          Int      // Calificación general (ej: 1 a 5)
  comment         String?  @db.Text

  // Campos granulares (especialmente para servicios)
  quality         Int?     // Calidad del trabajo
  professionalism Int?     // Profesionalismo
  communication   Int?     // Comunicación
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
// Este es el archivo "schema" de Prisma.
// Define la conexión a tu base de datos y la estructura de tus tablas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  INICIADO
  PENDING_WORK        // Trabajo contratado, pendiente de ejecución/cobro final
  PAGADO_EN_RETENCION
  COMPLETADO
  DISPUTADO
  CANCELADO
}

enum ListingType {
  PRODUCTO      
  SERVICIO      
  INFOPRODUCTO  
}

// Estado del ítem
enum ProductCondition {
  NUEVO
  USADO
  REACONDICIONADO
}

// --- MODELOS DE DATOS ---

// 1. Modelo de CATEGORÍAS
model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique 
  parentId    String?    
  parent      Category? @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 2. Modelo de USUARIO
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String?
  role                Role      @default(USER)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  products              Product[]
  services              Service[] // (Legacy)
  transactionsAsBuyer   Transaction[] @relation("BuyerTransactions")
  transactionsAsSeller  Transaction[] @relation("SellerTransactions")
  
  // -- SISTEMA DE CALIFICACIONES LEGACY (Rating) --
  ratingsGiven          Rating[]      @relation("RaterRatings")
  ratingsReceived       Rating[]      @relation("RatedRatings")
  
  // -- SISTEMA DE REPUTACIÓN V2 (Review & Reports) --
  reviewsWritten        Review[]      @relation("WrittenReviews")
  reviewsReceived       Review[]      @relation("ReceivedReviews")
  reportsMade           UserReport[]  @relation("ReporterReports")
  reportsReceived       UserReport[]  @relation("ReportedReports")

  professionalProfile   ProfessionalProfile?

  // RELACIONES DE PREGUNTAS
  questionsAsker        Question[]    @relation("AskerQuestions")

  // RELACIONES DE CHAT (NUEVO SPEC #009)
  sentMessages          Message[]     @relation("SentMessages")
}

// 3. Modelo de PERFIL PROFESIONAL (ACTUALIZADO SPEC #010)
model ProfessionalProfile {
  id              String    @id @default(uuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String    @unique

  // Campos de Identidad Profesional
  profession      String?   // Ej: "Electricista Matriculado" (Antes 'title')
  biography       String?   @db.Text // "Sobre mí / Experiencia" (Antes 'summary')
  
  // Campos de Evidencia / Portafolio
  portfolioImages String[]  // Array de URLs de fotos de trabajos
  certifications  String[]  // Lista de títulos o cursos realizados

  // Campos adicionales
  experienceYears Int?
  education       String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 4. Modelo de PRODUCTO (Publicación)
model Product {
  id            String      @id @default(uuid())
  creator       User        @relation(fields: [creatorId], references: [id])
  creatorId     String
  
  category      Category?   @relation(fields: [categoryId], references: [id])
  categoryId    String?      
  type          ListingType @default(PRODUCTO)

  title         String
  description   String      @db.Text
  price         Float
  images        String[]
  status        String      @default("DISPONIBLE") // DISPONIBLE, PAUSADO, SIN_STOCK

  // --- CONTROL DE STOCK ---
  stock         Int         @default(1) 

  // Detalles opcionales
  condition     ProductCondition? 
  brand         String?            
  model         String?            
  year          Int?                
  mileage       Int?                

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  transactions  Transaction[]
  
  // RELACIONES DE PREGUNTAS
  questions     Question[] 
}

// 5. Modelo de SERVICIO (LEGACY)
model Service {
  id              String    @id @default(uuid())
  creator         User      @relation(fields: [creatorId], references: [id])
  creatorId       String
  title           String
  description     String    @db.Text
  price           Float
  status          String    @default("DISPONIBLE")
  timesContracted Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions    Transaction[]
}

// 6. Modelo de TRANSACCIÓN
model Transaction {
  id              String            @id @default(uuid())
  buyer           User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  buyerId         String
  seller          User              @relation("SellerTransactions", fields: [sellerId], references: [id])
  sellerId        String
  
  product         Product?          @relation(fields: [productId], references: [id])
  productId       String?
  service         Service?          @relation(fields: [serviceId], references: [id])
  serviceId       String?

  status          TransactionStatus @default(INICIADO)
  amount          Float
  platformFee     Float
  sellerPayout    Float
  mercadoPagoId   String?           @unique
  
  // CAMPOS DE BORRADO LÓGICO
  deletedByBuyer  Boolean @default(false)
  deletedBySeller Boolean @default(false)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  rating          Rating? // (Legacy)
  review          Review? // (Sistema V2)
  
  // CHAT ASOCIADO (NUEVO SPEC #009)
  chatRoom        ChatRoom?
}

// 7. Modelo de CALIFICACIÓN (LEGACY)
model Rating {
  id            String      @id @default(uuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String      @unique
  
  rater         User        @relation("RaterRatings", fields: [raterId], references: [id])
  raterId       String
  rated         User        @relation("RatedRatings", fields: [ratedId], references: [id])
  ratedId       String
  
  rating        Int
  comment       String?     @db.Text
  
  quality       Int?
  professionalism Int?
  communication Int?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// 8. Modelo de PREGUNTAS (Q&A)
model Question {
  id          String   @id @default(uuid())
  content     String   @db.Text 
  
  answer      String?  @db.Text 
  answeredAt  DateTime?         
  
  isReadByAsker Boolean @default(false) 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt 

  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  
  asker       User     @relation("AskerQuestions", fields: [askerId], references: [id])
  askerId     String
}

// 9. Modelo de RESEÑAS (Review V2)
model Review {
  id            String      @id @default(uuid())
  
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String      @unique 

  reviewer      User        @relation("WrittenReviews", fields: [reviewerId], references: [id])
  reviewerId    String
  reviewed      User        @relation("ReceivedReviews", fields: [reviewedId], references: [id])
  reviewedId    String

  rating        Int         
  comment       String?     @db.Text
  createdAt     DateTime    @default(now())
}

// 10. Modelo de REPORTES (Seguridad V2)
model UserReport {
  id          String   @id @default(uuid())
  
  reporter    User     @relation("ReporterReports", fields: [reporterId], references: [id])
  reporterId  String
  
  reported    User     @relation("ReportedReports", fields: [reportedId], references: [id])
  reportedId  String

  reason      String   
  details     String?  @db.Text
  status      String   @default("PENDIENTE") 
  
  createdAt   DateTime @default(now())
}

// 11. SISTEMA DE CHAT (SPEC #009)

model ChatRoom {
  id            String      @id @default(uuid())
  
  // Relación 1:1 con Transacción (Un chat por compra)
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String      @unique

  messages      Message[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt // Importante para ordenar la inbox
}

model Message {
  id          String    @id @default(uuid())
  
  chatRoom    ChatRoom  @relation(fields: [chatRoomId], references: [id])
  chatRoomId  String

  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  senderId    String

  content     String    @db.Text
  isRead      Boolean   @default(false) 
  
  createdAt   DateTime  @default(now())
}
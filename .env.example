# Este es un archivo de ejemplo. Copialo a un archivo llamado .env
# y reemplazá los valores con tus credenciales reales.

# URL de conexión a la base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BasedeDatosMossTall?schema=public
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BasedeDatosMossTall?schema=public"

# Puerto en el que correrá el servidor de Node.js
PORT=3001
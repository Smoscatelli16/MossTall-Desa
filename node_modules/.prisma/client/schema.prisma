// Este es el archivo "schema" de Prisma.
// Define la conexión a tu base de datos y la estructura de tus tablas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  INICIADO
  PAGADO_EN_RETENCION
  COMPLETADO
  DISPUTADO
  CANCELADO
}

enum ListingType {
  PRODUCTO
  SERVICIO
  INFOPRODUCTO
}

// Estado del ítem
enum ProductCondition {
  NUEVO
  USADO
  REACONDICIONADO
}

// --- MODELOS DE DATOS ---

// 1. Modelo de CATEGORÍAS
model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. Modelo de USUARIO
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products             Product[]
  services             Service[] // (Legacy)
  transactionsAsBuyer  Transaction[]        @relation("BuyerTransactions")
  transactionsAsSeller Transaction[]        @relation("SellerTransactions")
  ratingsGiven         Rating[]             @relation("RaterRatings")
  ratingsReceived      Rating[]             @relation("RatedRatings")
  professionalProfile  ProfessionalProfile?

  // RELACIONES DE PREGUNTAS (NUEVO)
  questionsAsker Question[] @relation("AskerQuestions") // Preguntas que hice yo
}

// 3. Modelo de PERFIL PROFESIONAL
model ProfessionalProfile {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
  title           String?
  experienceYears Int?
  education       String?
  summary         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 4. Modelo de PRODUCTO (Publicación)
model Product {
  id        String @id @default(uuid())
  creator   User   @relation(fields: [creatorId], references: [id])
  creatorId String

  category   Category?   @relation(fields: [categoryId], references: [id])
  categoryId String?
  type       ListingType @default(PRODUCTO)

  title       String
  description String   @db.Text
  price       Float
  images      String[]
  status      String   @default("DISPONIBLE") // DISPONIBLE, PAUSADO, SIN_STOCK

  // --- CONTROL DE STOCK (NUEVO) ---
  stock Int @default(1) // Cantidad disponible

  // Detalles opcionales
  condition ProductCondition?
  brand     String?
  model     String?
  year      Int?
  mileage   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  // RELACIONES DE PREGUNTAS (NUEVO)
  questions Question[] // Preguntas recibidas en este producto
}

// 5. Modelo de SERVICIO (LEGACY)
model Service {
  id              String   @id @default(uuid())
  creator         User     @relation(fields: [creatorId], references: [id])
  creatorId       String
  title           String
  description     String   @db.Text
  price           Float
  status          String   @default("DISPONIBLE")
  timesContracted Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions Transaction[]
}

// 6. Modelo de TRANSACCIÓN
model Transaction {
  id       String @id @default(uuid())
  buyer    User   @relation("BuyerTransactions", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id])
  sellerId String

  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?

  status        TransactionStatus @default(INICIADO)
  amount        Float
  platformFee   Float
  sellerPayout  Float
  mercadoPagoId String?           @unique

  // CAMPOS DE BORRADO LÓGICO
  deletedByBuyer  Boolean @default(false)
  deletedBySeller Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating Rating?
}

// 7. Modelo de CALIFICACIÓN
model Rating {
  id            String      @id @default(uuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String      @unique

  rater   User   @relation("RaterRatings", fields: [raterId], references: [id])
  raterId String
  rated   User   @relation("RatedRatings", fields: [ratedId], references: [id])
  ratedId String

  rating  Int
  comment String? @db.Text

  quality         Int?
  professionalism Int?
  communication   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 8. Modelo de PREGUNTAS (Q&A) - NUEVO
model Question {
  id      String @id @default(uuid())
  content String @db.Text // La pregunta del interesado

  answer     String?   @db.Text // La respuesta del vendedor (opcional al inicio)
  answeredAt DateTime? // Cuándo se respondió

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Por si edita la respuesta

  // Relación con el Producto
  product   Product @relation(fields: [productId], references: [id])
  productId String

  // Relación con quien Pregunta (Asker)
  asker   User   @relation("AskerQuestions", fields: [askerId], references: [id])
  askerId String
}

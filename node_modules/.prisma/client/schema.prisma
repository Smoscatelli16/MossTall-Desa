// Este es el archivo "schema" de Prisma.
// Define la conexión a tu base de datos y la estructura de tus tablas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS (Tipos predefinidos) ---

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  INICIADO
  PAGADO_EN_RETENCION
  COMPLETADO
  DISPUTADO
  CANCELADO
}

// ¡NUEVO! Tipología de la Publicación (Para diferenciar lógica de envío/entrega)
enum ListingType {
  PRODUCTO // Bien físico (Requiere envío/logística)
  SERVICIO // Intangible (Requiere coordinación/agenda)
  INFOPRODUCTO // Digital (Requiere link de descarga o acceso)
}

// --- MODELOS DE DATOS ---

// 1. Modelo de CATEGORÍAS (Estructura de Árbol)
model Category {
  id   String @id @default(uuid())
  name String
  slug String @unique // Para URLs amigables (ej: "tecnologia-celulares")

  // Relación Recursiva (Categoría Padre e Hijas)
  parentId String? // Puede ser null si es una Categoría Principal
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")

  // Relación con Productos
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. Modelo de USUARIO
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  products             Product[]
  services             Service[] // (Legacy) Mantener por compatibilidad temporal
  transactionsAsBuyer  Transaction[]        @relation("BuyerTransactions")
  transactionsAsSeller Transaction[]        @relation("SellerTransactions")
  ratingsGiven         Rating[]             @relation("RaterRatings")
  ratingsReceived      Rating[]             @relation("RatedRatings")
  professionalProfile  ProfessionalProfile?
}

// 3. Modelo de PERFIL PROFESIONAL
model ProfessionalProfile {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
  title           String?
  experienceYears Int?
  education       String?
  summary         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 4. Modelo de PRODUCTO (Ahora es la entidad central "Publicación")
model Product {
  id        String @id @default(uuid())
  creator   User   @relation(fields: [creatorId], references: [id])
  creatorId String

  // ¡NUEVO! Clasificación y Tipología
  category   Category?   @relation(fields: [categoryId], references: [id])
  categoryId String? // Opcional temporalmente para no romper productos viejos
  type       ListingType @default(PRODUCTO) // Por defecto es físico

  title       String
  description String   @db.Text
  price       Float
  images      String[]
  status      String   @default("DISPONIBLE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  transactions Transaction[]
}

// 5. Modelo de SERVICIO (LEGACY / DEPRECATED)
// NOTA DE ARQUITECTURA: A futuro, los servicios deben migrarse a la tabla Product
// con type="SERVICIO". Mantenemos esta tabla para no romper lógica existente hoy.
model Service {
  id              String   @id @default(uuid())
  creator         User     @relation(fields: [creatorId], references: [id])
  creatorId       String
  title           String
  description     String   @db.Text
  price           Float
  status          String   @default("DISPONIBLE")
  timesContracted Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions Transaction[]
}

// 6. Modelo de TRANSACCIÓN
model Transaction {
  id       String @id @default(uuid())
  buyer    User   @relation("BuyerTransactions", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id])
  sellerId String

  // Relación con Items (Soporta el modelo nuevo y el viejo)
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?

  status        TransactionStatus @default(INICIADO)
  amount        Float
  platformFee   Float
  sellerPayout  Float
  mercadoPagoId String?           @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating Rating?
}

// 7. Modelo de CALIFICACIÓN
model Rating {
  id            String      @id @default(uuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String      @unique

  rater   User   @relation("RaterRatings", fields: [raterId], references: [id])
  raterId String
  rated   User   @relation("RatedRatings", fields: [ratedId], references: [id])
  ratedId String

  rating  Int
  comment String? @db.Text

  quality         Int?
  professionalism Int?
  communication   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
